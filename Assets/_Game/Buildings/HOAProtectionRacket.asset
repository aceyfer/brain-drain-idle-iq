MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 43c2bea8f63d2184cb87c13fcf9bc1e3, type: 3}
  m_Name: HOAProtectionRacket
  m_EditorClassIdentifier: Assembly-CSharp::BrainDrain.Core.BuildingData
  buildingId: hoa_protection_racket
  buildingName: The Laundromat
  description: Dirty money in, clean water out. Nobody upstairs has audited it because nobody upstairs can read the ledger.
  unlockCumulativeBrainPower: 18000
  costType: 1
  baseCost: 1200
  costMultiplier: 1.16
  baseCashPerSecond: 20
  evolutions:
  - stageIndex: 1
    displayName: 
    description: 'Dirty money in, clean water out. Someone has started keeping a second ledger. Badly, and in pencil.'
  - stageIndex: 2
    displayName: 'The Second Ledger'
    description: 'The pencil ledger outgrew the pencil. It''s a real book now, kept somewhere else, and four people know where.'
  - stageIndex: 3
    displayName: 
    description: 'Four people knew where it was. One of them stopped showing up in March. The book moved that week and the other three didn''t discuss it.'
  - stageIndex: 4
    displayName: 
    description: 'The one who stopped showing up in March has a name that gets said out loud now, at the top of the book, on the first page.'
  - stageIndex: 5
    displayName: 'The Laundromat'
    description: 'Clean money in, clean water out, and the book is public. It is the most boring document in the city, and the name on the first page is why anyone fought to make it that dull.'
