--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 43c2bea8f63d2184cb87c13fcf9bc1e3, type: 3}
  m_Name: SynapseSpaceHeater
  m_EditorClassIdentifier: Assembly-CSharp::BrainDrain.Core.BuildingData
  buildingId: synapse_space_heater
  buildingName: Hyperbolic Brain Chamber
  description: An hour inside is a year of thinking outside. Your mind trains in dilated dream-time and comes back sharper — assuming it comes back.
  unlockCumulativeBrainPower: 4000
  costType: 0
  baseCost: 900
  costMultiplier: 1.12
  baseBrainPowerPerSecond: 12
  evolutions:
  - stageIndex: 1
    displayName: 
    description: 'An hour inside is a year of thinking. Most people use the year on nothing. A few come out with questions.'
  - stageIndex: 2
    displayName: 
    description: 'A year of thinking per hour. The ones who come out with questions have started recognizing each other, which was not a feature anyone designed.'
  - stageIndex: 3
    displayName: 
    description: 'The ones who recognize each other have started using the hour deliberately — same problem, different heads, compared after. It is the fastest thinking anyone has done in two centuries.'
  - stageIndex: 4
    displayName: 
    description: 'The chambers run continuously now, in shifts, on problems assigned by someone. Strategy is a thing being done at speed.'
  - stageIndex: 5
    displayName: 
    description: 'An hour inside is still a year of thinking. People come out and go do something with it, which was never the bottleneck anyone expected it to be.'
