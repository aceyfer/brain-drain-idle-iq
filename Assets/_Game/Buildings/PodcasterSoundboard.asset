%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 43c2bea8f63d2184cb87c13fcf9bc1e3, type: 3}
  m_Name: PodcasterSoundboard
  m_EditorClassIdentifier: Assembly-CSharp::BrainDrain.Core.BuildingData
  buildingId: podcaster_soundboard
  buildingName: Podcaster Soundboard
  description: Three guys in a garage explain geopolitics for four hours using
    only vibes. Somehow, people are taking notes.
  unlockCumulativeBrainPower: 25000
  costType: 1
  baseCost: 30
  costMultiplier: 1.21
  baseBrainPowerPerSecond: 5
  evolutions:
  - stageIndex: 1
    displayName: 
    description: 'Four hours of vibes. In hour three, one of them asked a question the other two couldn''t answer, and the silence made the clip.'
  - stageIndex: 2
    displayName: 
    description: 'The unanswerable question got asked again, by someone else, on a different show. Neither host has mentioned the other.'
  - stageIndex: 3
    displayName: 
    description: 'Both hosts stopped broadcasting within a week of each other. The clips kept circulating, cut differently, by people who were not either host.'
  - stageIndex: 4
    displayName: 
    description: 'The clips became broadcasts. The broadcasts became a channel. The two hosts who stopped are credited on every one of them and neither has been seen.'
  - stageIndex: 5
    displayName: 'The Long Form'
    description: 'Still four hours, still three of them in a garage. Now they read first, and when they don''t know, they say so out loud, and nobody clips it.'
