  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 43c2bea8f63d2184cb87c13fcf9bc1e3, type: 3}
  m_Name: JumperCables
  m_EditorClassIdentifier: Assembly-CSharp::BrainDrain.Core.BuildingData
  buildingId: jumper_cables
  buildingName: Apex Brain Greens
  description: A scoop of pond-colored powder, 47 ingredients nobody regulated.
    Steady drip while it's in your system, and every tap hits harder on top.
    The whole feed swears by it.
  unlockCumulativeBrainPower: 0
  costType: 0
  baseCost: 15
  costMultiplier: 1.12
  baseBrainPowerPerSecond: 0.5
  tapBrainPowerPerLevel: 0.02
  evolutions:
  - stageIndex: 1
    displayName: 'Apex Greens'
    description: 'The word "Brain" came off the label this year. No announcement. The formula didn''t change and neither did the price.'
  - stageIndex: 2
    displayName: 
    description: 'Still pond-colored powder. But someone in the comments posted the actual ingredient list, and the comment stayed up for nine hours before it didn''t.'
  - stageIndex: 3
    displayName: 'Green Powder'
    description: 'The branding came off entirely. It''s a sack with a weight written on it, distributed through channels that also move other things.'
  - stageIndex: 4
    displayName: 
    description: 'The sacks move under escort now. Nobody drinks it for the promise on the label, because there isn''t one. They drink it because the people carrying it need to keep going.'
  - stageIndex: 5
    displayName: 'Just Vegetables'
    description: 'Grown in dirt, outside, by people who are not selling anything. Forty-seven ingredients turned out to be seven, and none of them had names worth trademarking.'
